# ─────────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in the values.
# `.env.local` is git-ignored; this template is committed.
# ─────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────
# Firebase client configuration
#
# Public client values — they ship in the browser bundle by design. Read from
# the environment so the project can be pointed elsewhere without editing
# source. The app falls back to the default project when a variable is absent.
# ─────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ─────────────────────────────────────────────────────────
# Operations allowlist
#
# Comma-separated e-mail addresses authorised to operate the admin console.
# Whitespace is tolerated and matching is case-insensitive.
#
#   NEXT_PUBLIC_PERMITTED_EMAILS=webedge244@gmail.com,hs@gmail.com
#
# Keep this list in sync with the `isAdmin()` helper inside `firestore.rules` —
# Security Rules cannot read environment variables.
# ─────────────────────────────────────────────────────────
NEXT_PUBLIC_PERMITTED_EMAILS=

# ─────────────────────────────────────────────────────────
# Admin session signing secret
#
# Used to sign the HttpOnly admin session cookie (HMAC-SHA256).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# SERVER ONLY — never prefix this with NEXT_PUBLIC_.
# Rotating it invalidates every active admin session.
# ─────────────────────────────────────────────────────────
SESSION_SECRET=
