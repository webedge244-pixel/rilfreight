rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Verifies admin access via authenticated email allowlist (case-insensitive) or custom admin claim.
    function isAdmin() {
      return request.auth != null && (
        (request.auth.token.email != null &&
         request.auth.token.email.lower() in [
           'webedge244@gmail.com'
         ]) ||
        request.auth.token.admin == true
      );
    }

    // Public tracking: customers can retrieve individual shipment documents by tracking code.
    match /shipments/{shipmentId} {
      allow get: if true;
    }

    // Public forms: visitors can submit quote requests and contact messages.
    match /quoteRequests/{requestId} {
      allow create: if true;
    }

    match /contactMessages/{messageId} {
      allow create: if true;
    }

    // Unrestricted admin operations: verified administrators have full read and write access across all collections.
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
